  "hub_notes": {
    "issue_create": "The OpenAPI body for POST /api/companies/{companyId}/issues is untyped. Field names come from commit 6f1bf175 packages/shared/src/validators/issue.ts createIssueSchema: title, description, status (defaulted), priority (defaulted), idempotencyKey (trimmed, 1..255; the server replays the original issue for a repeated key).",
    "approval_create": "type=request_board_approval is the general board approval type; payload is a free-form object. The hub sends title, summary, release_revision_id, payload_hash and actions in payload, and links the issue via issueIds.",
    "approval_statuses": [
      "pending",
      "approved",
      "rejected",
      "revision_requested",
      "cancelled"
    ],
    "decided_by": "Approvals record the deciding human board user in decidedByUserId; the bearer API key identity is never used as the decider.",
    "comments": "GET/POST /api/approvals/{id}/comments; POST body {\"body\": string}."
  },
