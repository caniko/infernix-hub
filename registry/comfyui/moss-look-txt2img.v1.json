          "4",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "6",
          0
        ],
        "latent_image": [
          "7",
          0
        ],
        "seed": 0,
        "steps": 25,
        "cfg": 2.5,
        "sampler_name": "er_sde",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "9": {
      "class_type": "VAEDecodeTiled",
      "inputs": {
        "samples": [
          "8",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "tile_size": 512,
        "overlap": 64,
        "temporal_size": 64,
        "temporal_overlap": 8
      }
    },
    "20": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "9",
          0
        ],
        "filename_prefix": "hub/look"
      }
    }
